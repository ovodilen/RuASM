{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ruasm:json-schema:ruasm-version-v1",
  "title": "RUASM --version=json schema v1",
  "type": "object",
  "required": [
    "schema_version",
    "name",
    "version",
    "host",
    "target",
    "self_hosted",
    "output_format"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "name": {
      "const": "RUASM"
    },
    "version": {
      "type": "string"
    },
    "host": {
      "type": "string"
    },
    "target": {
      "type": "string"
    },
    "self_hosted": {
      "type": "boolean"
    },
    "output_format": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
